/* ==========================================
   ESTILO GLOBAL DARK THEME - CREG IUA
   ========================================== */

/* --- FONDO PRINCIPAL Y TEXTO --- */
QWidget {
    background-color: #15234A; /* Fondo principal azul marino oscuro de la marca */
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #f4f5f7; /* Texto claro */
    font-size: 13px;
}

QMainWindow {
    background-color: #15234A;
}

/* --- PESTAÑAS (QTabWidget) --- */
QTabWidget::pane {
    border: 1px solid #384792; /* Azul púrpura secundario */
    background-color: #1c2a55; /* Un tono ligeramente más claro que el fondo */
    border-radius: 6px;
    margin-top: -1px; 
}

QTabBar::tab {
    background-color: #101a38; /* Más oscuro para pestañas inactivas */
    color: #BDC4C2; /* Gris marca para texto inactivo */
    padding: 12px 25px; 
    min-width: 180px; 
    min-height: 25px; 
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border: 1px solid #384792;
    border-bottom: none;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #1c2a55; /* Igual al panel activo */
    color: white; 
    border-top: 3px solid #00ae9a; /* Acento teal primario */
}

QTabBar::tab:hover:!selected {
    background-color: #18254c;
}

/* --- CAMPOS DE TEXTO Y DESPLEGABLES --- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #101a38; /* Fondo oscuro */
    border: 1px solid #384792;
    border-radius: 4px;
    padding: 6px 10px;
    color: white;
    selection-background-color: #0099dd;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #00ae9a; /* Acento teal al hacer clic */
    background-color: #18254c; 
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    border: 1px solid #384792;
    background-color: #101a38;
    color: white;
    selection-background-color: #0055b8; 
}

/* --- BOTONES BASE --- */
QPushButton {
    background-color: #0099dd; 
    color: white;
    border-radius: 4px;
    padding: 8px 15px; 
    font-weight: bold;
    border: none;
}

QPushButton:hover {
    background-color: hsl(198, 100%, 63%); /* Azul claro secundario al pasar el mouse */
}

QPushButton:pressed {
    background-color: hsl(198, 100%, 33%);
    color: white;
}

QPushButton:disabled {
    background-color: #384792; /* Un gris azulado oscuro para inactivos */
    color: #BDC4C2;
}

/* --- TABLAS (QTableView) --- */
QTableView {
    background-color: #101a38;
    alternate-background-color: #15234A; 
    selection-background-color: #0055b8; 
    selection-color: white;
    border: 1px solid #384792;
    border-radius: 4px;
    gridline-color: #384792; /* Líneas de cuadrícula */
    color: white;
}

QHeaderView::section {
    background-color: #0055b8; /* Azul primario para encabezados */
    color: white;
    padding: 6px;
    font-weight: bold;
    border: none;
    border-right: 1px solid #101a38; 
}

QTableView::item {
    padding: 4px;
}

/* --- BARRAS DE DESPLAZAMIENTO MINIMALISTAS --- */
QScrollBar:vertical {
    border: none;
    background: #101a38;
    width: 8px; 
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #384792;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #00ae9a;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none; 
}

QScrollBar:horizontal {
    border: none;
    background: #101a38;
    height: 8px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background: #384792;
    min-width: 20px;
    border-radius: 4px;
}

/* --- ETIQUETAS (Labels) --- */
QLabel {
    font-weight: bold;
    color: #78BEED; /* Azul claro para que resalte en el fondo oscuro */
}

/* ==========================================
   BOTONES CON ESTILOS ESPECÍFICOS (IDs)
   ========================================== */

#export-btn {
    background-color: #384792; 
}
#export-btn:hover {
    background-color: rgba(97, 103, 255, 1); 
}
#export-btn:pressed {
    background-color: rgba(36, 46, 94, 1);
}

#success-btn {
    background-color: #00ae9a;
}
#success-btn:hover { background-color: hsl(173, 100%, 54%); color: white; }
#success-btn:pressed { background-color: hsl(173, 100%, 24%); }

#danger-btn {
    background-color: #E61D59;
}
#danger-btn:hover { background-color: hsl(342, 80%, 71%); }
#danger-btn:pressed { background-color: hsl(342, 80%, 41%); }

#run-batch-btn {
    padding: 10px;
    background-color: #0055b8;
    font-size: 14px;
}
#run-batch-btn:hover { background-color: hsl(212, 100%, 56%); }

/* NUEVO: Botón de Copiar TODOS (Mostaza Translúcido) */
#warning-btn { 
    background-color: rgba(227, 179, 44, 180);
    color: white; 
    font-weight: bold; 
}
#warning-btn:hover { 
    background-color: hsl(44, 77%, 73%);
}
#warning-btn:pressed {
    background-color: hsl(44, 77%, 43%);
}

/* NUEVO: Botón de Liberar TODOS (Rojo Oscuro Translúcido) */
#danger-all-btn { 
    background-color: rgba(179, 22, 69, 180); 
    color: white; 
    font-weight: bold; 
}
#danger-all-btn:hover { 
    background-color: hsl(342, 78%, 59%);
}
#danger-all-btn:pressed {
    background-color: hsl(342, 78%, 29%);
}

/* Actualiza la regla de inactivos al final de theme_glass.qss */
#export-btn:disabled, 
#success-btn:disabled, 
#danger-btn:disabled, 
#danger-all-btn:disabled, 
#warning-btn:disabled, 
#run-batch-btn:disabled {
    background-color: rgba(189, 196, 194, 80);
    color: rgba(255, 255, 255, 150);
    border: 1px solid rgba(255, 255, 255, 30);
}

QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.1); /* Fondo semitransparente */
    text-align: center;
    color: #f4f5f7;
}

QProgressBar::chunk {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #ff4d6d, stop:1 #ff8fa3); /* Degradado moderno */
    border-radius: 4px;
}
