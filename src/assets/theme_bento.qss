/* ==========================================
   TEMA: BENTO UI (BORDES REDONDEADOS Y TARJETAS)
   ========================================== */

/* --- FONDO PRINCIPAL Y TEXTO --- */
QWidget {
    background-color: #f4f5f7;
    font-family: 'Segoe UI', Arial, sans-serif;
    color: #15234A; /* Azul marino corporativo */
    font-size: 13px;
}

QMainWindow {
    background-color: #f4f5f7;
}

/* --- PESTAÑAS (QTabWidget) --- */
QTabWidget::pane {
    background-color: white;
    border: 1px solid #e0e4e8;
    border-radius: 16px; /* Borde muy redondeado típico de Bento */
    margin-top: 10px; /* Separación marcada entre las "píldoras" y la tarjeta principal */
    padding: 10px;
}

QTabBar::tab {
    background-color: white;
    color: #384792;
    padding: 10px 20px;
    min-width: 150px;
    min-height: 25px;
    margin-right: 8px; /* Separación entre pestañas estilo "píldora" */
    border: 1px solid #e0e4e8;
    border-radius: 12px; /* Pestañas redondeadas independientes */
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #0099dd; 
    color: white;
    border: 1px solid #0099dd;
}

QTabBar::tab:hover:!selected {
    background-color: #f0f2f5;
}

/* --- CAMPOS DE TEXTO Y DESPLEGABLES --- */
QLineEdit, QComboBox, QSpinBox {
    background-color: #f9fafb;
    border: 1px solid #e0e4e8;
    border-radius: 10px; /* Bordes Bento suaves */
    padding: 8px 14px;
    color: #15234A;
    selection-background-color: #78BEED;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 2px solid #00ae9a; /* Acento teal de la marca */
    background-color: white;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

QComboBox QAbstractItemView {
    border: 1px solid #e0e4e8;
    border-radius: 10px;
    background-color: white;
    selection-background-color: #78BEED;
    selection-color: #15234A;
}

/* --- TABLAS (QTableView) --- */
QTableView {
    background-color: white;
    alternate-background-color: #f9fafb;
    selection-background-color: #78BEED;
    selection-color: #15234A;
    border: 1px solid #e0e4e8;
    border-radius: 12px; /* Tabla contenida en su propia tarjeta redondeada */
    gridline-color: #f0f2f5;
}

QHeaderView::section {
    background-color: white;
    color: #384792;
    padding: 10px;
    font-weight: bold;
    border: none;
    border-bottom: 2px solid #e0e4e8;
    border-right: 1px solid #f0f2f5;
}

QTableView::item {
    padding: 6px;
}

/* --- BOTONES BASE --- */
QPushButton {
    background-color: white;
    color: #15234A;
    border: 1px solid #e0e4e8;
    border-radius: 12px; /* Botones más circulares */
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #f0f2f5;
    border: 1px solid #BDC4C2;
}

QPushButton:pressed {
    background-color: #e0e4e8;
}

QPushButton:disabled {
    background-color: #f4f5f7;
    color: #BDC4C2;
    border: 1px solid #e0e4e8;
}

/* --- ETIQUETAS --- */
QLabel {
    font-weight: bold;
    color: #15234A;
}

/* ==========================================
   BOTONES CON ESTILOS ESPECÍFICOS (IDs)
   ========================================== */
#export-btn {
    background-color: #384792;
    border: 1px solid #15234A;
    color: white;
    border: none;
}
#export-btn:hover { background-color: #15234A; border: 1px solid hsl(224, 56%, 10%); }
#export-btn:pressed { background-color: hsl(224, 56%, 14%); }

#success-btn {
    background-color: #00ae9a;
    border: 1px solid #007c6e;
    color: white;
    border: none;
}
#success-btn:hover { background-color: #007c6e; }
#success-btn:pressed { background-color: hsl(173, 100%, 19%); border: 1px solid hsl(173, 100%, 15%); }

#danger-btn {
    background-color: #E61D59;
    border: 1px solid #b31645;
    color: white;
    border: none;
}
#danger-btn:hover { background-color: #b31645; }
#danger-btn:pressed { background-color: hsl(342, 78%, 34%); border: 1px solid hsl(342, 78%, 30%); }

#danger-all-btn {
    background-color: #b31645;
    border: 1px solid #8a1135;
    color: white;
    border: none;
}
#danger-all-btn:hover { background-color: #8a1135; }
#danger-all-btn:pressed { background-color: hsl(342, 78%, 25%); border: 1px solid hsl(342, 78%, 21%); }

#warning-btn {
    background-color: #E3B32C;
    border: 1px solid hsl(44, 77%, 44%);
    color: #15234A;
    border: none;
}
#warning-btn:hover { background-color: hsl(44, 77%, 44%); }
#warning-btn:pressed { background-color: hsl(44, 77%, 38%); border: 1px solid hsl(44, 77%, 34%); }

#run-batch-btn {
    padding: 12px;
    background-color: #0055b8;
    color: white;
    font-size: 14px;
    border-radius: 14px; /* Extremo redondeo para el botón principal */
    border: none;
}
#run-batch-btn:hover { background-color: #0099dd; }
#run-batch-btn:pressed { background-color: hsl(198, 100%, 38%); border: 1px solid hsl(198, 100%, 34%); }

/* Inactivos específicos */
#export-btn:disabled, 
#success-btn:disabled, 
#danger-btn:disabled, 
#danger-all-btn:disabled, 
#warning-btn:disabled, 
#run-batch-btn:disabled {
    background-color: #BDC4C2;
    color: white;
}

/* --- BARRAS DE DESPLAZAMIENTO ESTILO PÍLDORA --- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 2px;
}
QScrollBar::handle:vertical {
    background: #BDC4C2;
    min-height: 20px;
    border-radius: 5px; /* Scroll redondeado */
}
QScrollBar::handle:vertical:hover {
    background: #78BEED;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}
QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 2px;
}
QScrollBar::handle:horizontal {
    background: #BDC4C2;
    min-width: 20px;
    border-radius: 5px;
}

QProgressBar {
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    background-color: #f8f9fa;
    text-align: center;
    color: #15234A; /* Azul oscuro para que el porcentaje se lea bien */
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #0099dd; /* Color primario (Celeste/Azul) */
    border-radius: 5px;
}
