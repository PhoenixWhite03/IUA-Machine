/* ==========================================
   TEMA: GLASSMORPHISM CORPORATIVO (ALTO CONTRASTE)
   ========================================== */

/* --- CONFIGURACIÓN GLOBAL --- */
QWidget {
    font-family: 'Segoe UI', Arial, sans-serif;
    color: white;
    font-size: 13px;
}

QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, 
                                stop:0 #15234A, stop:0.5 #0055b8, stop:1 #00ae9a);
}

/* --- VENTANAS EMERGENTES Y DIÁLOGOS (¡Solución de contraste!) --- */
QDialog, QMessageBox {
    background-color: #f4f5f7; /* Fondo claro corporativo sólido para que sean legibles */
    color: #15234A; /* Letra azul oscuro obligatoria */
}

QDialog QLabel, QMessageBox QLabel {
    color: #15234A; /* Forzar texto oscuro en los mensajes emergentes */
}

/* --- PESTAÑAS (QTabWidget) --- */
QTabWidget::pane, QTableView, QWidget#panel_fondo {
    background-color: rgba(255, 255, 255, 35); 
    border: 1px solid rgba(255, 255, 255, 60); 
    border-radius: 6px; 
    margin-top: -1px; 
}

QTabBar::tab {
    background-color: rgba(255, 255, 255, 20);
    color: white;
    padding: 12px 25px; 
    min-width: 180px;   
    min-height: 25px;   
    margin-right: 2px;
    border: 1px solid rgba(255, 255, 255, 40);
    border-top-left-radius: 6px; 
    border-top-right-radius: 6px;
    border-bottom: none;
    font-weight: bold;  
}

QTabBar::tab:selected {
    background-color: rgba(255, 255, 255, 65); 
    color: #15234A; /* Texto oscuro en pestaña activa para mayor contraste */
    border-top: 3px solid #00ae9a; 
}

QTabBar::tab:hover:!selected {
    background-color: rgba(255, 255, 255, 40);
}

/* --- CAMPOS DE TEXTO Y DESPLEGABLES --- */
QLineEdit, QComboBox, QSpinBox {
    background-color: rgba(0, 0, 0, 45); 
    border: 1px solid rgba(255, 255, 255, 50);
    border-radius: 4px; 
    padding: 6px 10px;  
    color: white;
    selection-background-color: rgba(0, 153, 221, 180);
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #00ae9a;
    background-color: rgba(0, 0, 0, 65);
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

/* Listas desplegables y elementos de selección (Segunda pestaña / ComboBox views) */
QComboBox QAbstractItemView, QListView {
    background-color: #15234A; /* Fondo sólido oscuro corporativo */
    border: 1px solid rgba(255, 255, 255, 50);
    color: white; /* Texto blanco legible */
    selection-background-color: #0099dd;
    selection-color: white;
}

/* --- TABLAS (QTableView / Listas de IUA disponibles) --- */
QTableView {
    background-color: rgba(21, 35, 74, 160); /* Fondo azul marino translúcido oscuro */
    color: white;
    gridline-color: rgba(255, 255, 255, 30);
    selection-background-color: #0055b8;
    selection-color: white;
}

QTableView::item {
    padding: 4px;
    color: white; /* Letra blanca garantizada en las celdas */
}

QTableView::item:selected {
    background-color: #0055b8;
    color: white;
}

QHeaderView::section {
    background-color: rgba(21, 35, 74, 200); 
    color: white;
    border: none;
    padding: 6px; 
    font-weight: bold;
    border-right: 1px solid rgba(255, 255, 255, 40);
}

/* --- BOTONES BASE --- */
QPushButton {
    background-color: rgba(0, 153, 221, 190); 
    color: white;
    border: 1px solid rgba(255, 255, 255, 80);
    border-radius: 4px;  
    padding: 8px 15px;   
    font-weight: bold;
}

QPushButton:hover {
    background-color: rgba(0, 85, 184, 220); 
}

QPushButton:pressed {
    background-color: hsl(212, 100%, 21%);
}

QPushButton:disabled {
    background-color: rgba(189, 196, 194, 80); 
    color: rgba(255, 255, 255, 150);
    border: 1px solid rgba(255, 255, 255, 30);
}

/* --- BARRAS DE DESPLAZAMIENTO --- */
QScrollBar:vertical {
    border: none;
    background: rgba(0, 0, 0, 20);
    width: 8px; 
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 50);
    min-height: 20px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #00ae9a;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    border: none;
    background: none; 
}
QScrollBar:horizontal {
    border: none;
    background: rgba(0, 0, 0, 20);
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 50);
    min-width: 20px;
    border-radius: 4px;
}

/* --- ETIQUETAS GENERALES --- */
QLabel {
    font-weight: bold;
    color: white;
}

/* ==========================================
   BOTONES CON ESTILOS ESPECÍFICOS (IDs)
   ========================================== */
#export-btn {
    background-color: rgba(56, 71, 146, 190); 
}
#export-btn:hover { background-color: hsl(230, 45%, 35%); }
#export-btn:pressed { background-color: rgba(21, 35, 74, 220); }

#success-btn {
    background-color: rgba(0, 174, 154, 190); 
}
#success-btn:hover { background-color: rgba(0, 124, 110, 220); }

#danger-btn {
    background-color: rgba(230, 29, 89, 190); 
}
#danger-btn:hover { background-color: rgba(179, 22, 69, 220); }
#danger-btn:pressed { background-color: hsl(342, 78%, 25%) }

#danger-all-btn { 
    background-color: rgba(179, 22, 69, 190); 
    color: white; 
    font-weight: bold; 
}
#danger-all-btn:hover { background-color: rgba(138, 17, 53, 220); }
#danger-all-btn:pressed { background-color: hsl(342, 78%, 19%) }

#warning-btn { 
    background-color: rgba(227, 179, 44, 190); 
    color: white; 
    font-weight: bold; 
}
#warning-btn:hover { 
    background-color: rgba(134, 126, 11, 220);
}
#warning-btn:pressed {
    background-color: hsl(56, 85%, 15%)
}

#run-batch-btn {
    padding: 10px; 
    background-color: rgba(0, 85, 184, 190); 
    font-size: 14px;
}
#run-batch-btn:hover { background-color: hsl(212, 100%, 30%); }
#run-batch-btn:pressed { background-color: hsl(212, 100%, 15%); }

/* Control de inactivos para botones específicos */
#export-btn:disabled, 
#success-btn:disabled, 
#danger-btn:disabled, 
#danger-all-btn:disabled, 
#warning-btn:disabled, 
#run-batch-btn:disabled {
    background-color: rgba(189, 196, 194, 80);
    color: rgba(255, 255, 255, 150);
    border: 1px solid rgba(255, 255, 255, 30);
}

QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.1); /* Fondo semitransparente */
    text-align: center;
    color: #f4f5f7;
}

QProgressBar::chunk {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #ff4d6d, stop:1 #ff8fa3); /* Degradado moderno */
    border-radius: 4px;
}
